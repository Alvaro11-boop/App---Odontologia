<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="FarmaApp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ultimointento"
        tools:targetApi="31">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".patient.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".patient.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".patient.CartActivity"
            android:exported="false" />

        <activity
            android:name=".patient.OrdersActivity"
            android:exported="false" />

        <activity
            android:name=".patient.DomiciliariosActivity"
            android:exported="false" />
    </application>

</manifest>