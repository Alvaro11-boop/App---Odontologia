<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvApptDentistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Con: Dr. Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/tvApptDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha: YYYY-MM-DD"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvApptTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hora: HH:MM"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"/>
            
        <TextView
            android:id="@+id/tvApptStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONFIRMADA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/type_patient"
            android:layout_marginTop="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAppointment"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/error"
            android:text="Cancelar Cita"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
